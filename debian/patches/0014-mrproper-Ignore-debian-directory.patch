 Makefile | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Makefile b/Makefile
index 73e7bac7527e..8d9d338ea64c 100644
--- a/Makefile
+++ b/Makefile
@@ -1746,7 +1746,7 @@ CLEAN_FILES += vmlinux.symvers modules-only.symvers \
 # Directories & files removed with 'make mrproper'
